# Local virtualenv and caches
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Benchmark-run bulk that is NOT evidence: frozen source duplicates used for
# concurrent-edit-proof matrix execution, failed-run diagnostic retries, and
# live-run markers/logs. The promoted/receipt artifacts themselves ARE tracked.
outputs/forager/frozen_src_*/
outputs/forager/*failed_source_drift*/
outputs/forager/relearning_logs/
outputs/forager/local_toolchain/
outputs/forager/**/*.running
outputs/upgd_ipmnist/reconstructed_openml_cache/
outputs/upgd_label_emnist/openml_cache/
outputs/forager/*/sources/
# Keep the matched-current qualification's Alberta snapshot reconstructable
# while excluding its larger upstream source mirrors.
!outputs/forager/matched_current_qualification_2c3b214c_v1/sources/
outputs/forager/matched_current_qualification_2c3b214c_v1/sources/*
!outputs/forager/matched_current_qualification_2c3b214c_v1/sources/alberta/
outputs/forager/matched_current_qualification_2c3b214c_v1/sources/alberta/*
!outputs/forager/matched_current_qualification_2c3b214c_v1/sources/alberta/inventory.json
!outputs/forager/matched_current_qualification_2c3b214c_v1/sources/alberta/snapshot-descriptor.json
!outputs/forager/matched_current_qualification_2c3b214c_v1/sources/alberta/source.tar
outputs/**/logs/
# launcher stop sentinel for in-run memguard; never committed
outputs/**/MEMGUARD_STOP
